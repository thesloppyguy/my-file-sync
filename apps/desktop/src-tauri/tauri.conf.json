{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My Share",
  "version": "0.1.0",
  "identifier": "com.mysync.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Get Started",
        "width": 440,
        "height": 520,
        "minWidth": 380,
        "minHeight": 420,
        "resizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#171a24",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "msi",
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}