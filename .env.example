# Registry
PORT=8787
HOST=0.0.0.0
SQLITE_PATH=./services/registry/data/registry.sqlite
RELAY_MULTIADDR=/ip4/127.0.0.1/tcp/4001/p2p/REPLACE_WITH_RELAY_PEER_ID

# Optional SMTP (without this, OTPs are logged to the registry console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@mysync.local

# Desktop
MYSYNC_REGISTRY_URL=http://127.0.0.1:8787
